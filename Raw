local function removerTagDePersonagem(character)
    if not character then return end
    local head = character:FindFirstChild("Head")
    if head then
        local oldTag = head:FindFirstChild("BrocasitxHeadTag")
        if oldTag then oldTag:Destroy() end
    end
end

local function aplicarTagEmPersonagem(targetPlayer, character)
    if not targetPlayer or not character then return end
    if targetPlayer == LP then return end

    if not activeScriptUsers[tostring(targetPlayer.UserId)] then
        removerTagDePersonagem(character)
        return
    end

    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 5)
    if not head then return end

    removerTagDePersonagem(character)

    local tagText = getRoleTag(targetPlayer)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "BrocasitxHeadTag"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(130, 26)
    billboard.StudsOffset = Vector3.new(0, 3.1, 0)
    billboard.AlwaysOnTop = false
    billboard.MaxDistance = 80
    billboard.Parent = head

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(45, 45, 45)
    stroke.Thickness = 1
    stroke.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = tagText
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = frame

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 6)
    padding.PaddingRight = UDim.new(0, 6)
    padding.PaddingTop = UDim.new(0, 3)
    padding.PaddingBottom = UDim.new(0, 3)
    padding.Parent = label
end

local function atualizarTagsDeTodos()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            if activeScriptUsers[tostring(plr.UserId)] then
                aplicarTagEmPersonagem(plr, plr.Character)
            else
                removerTagDePersonagem(plr.Character)
            end
        end
    end
end

