        if plr ~= LP and plr.Character then
            if activeScriptUsers[tostring(plr.UserId)] then
                aplicarTagEmPersonagem(plr, plr.Character)
            else
                removerTagDePersonagem(plr.Character)
            end
        end
    end
end

