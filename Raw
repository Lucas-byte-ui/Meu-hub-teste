local function pedirHttp(dados)
    local req = (syn and syn.request) or (http and http.request) or request or (fluxus and fluxus.request)
    return type(req) == "function" and req(dados) or nil
end

local function buscarAdminTemporarioNoFirebase(userId)
    local ok, res = pcall(function()
        return pedirHttp({
            Url = LINK_BANCO .. "/adminsTemporarios/" .. tostring(userId) .. ".json",
            Method = "GET"
        })
    end)

    if ok and res and res.Body and res.Body ~= "" and res.Body ~= "null" then
        local decOk, dados = pcall(function()
            return HttpService:JSONDecode(res.Body)
        end)
        if decOk and type(dados) == "table" and type(dados.expiraEm) == "number" then
            if os.time() < dados.expiraEm then
                return dados.expiraEm
            end
        end
    end
    return nil
end

local function hasTemporaryAdminActive()
    if type(tempoAdminTemporario) == "number" then
        if os.time() < tempoAdminTemporario then
            return true
        else
            tempoAdminTemporario = nil
        end
    end
    return false
end

local function isLocalAdminOrOwner()
    local n = string.lower(tostring(LP.Name))
    local d = string.lower(tostring(LP.DisplayName))
    if n == "luccasxtt" or d == "luccasxtt" or ADMINS_EXTRA[n] or ADMINS_EXTRA[d] == true then
        return true
    end
    return hasTemporaryAdminActive()
end

local function getRoleTag(player)
    if not player then return "USUÁRIO FREE" end
    local n = string.lower(tostring(player.Name))
    local d = string.lower(tostring(player.DisplayName))
    if n == "luccasxtt" or d == "luccasxtt" then
        return "OWNER"
    elseif ADMINS_EXTRA[n] or ADMINS_EXTRA[d] == true then
        return "USUÁRIO ADMIN"
    elseif player == LP and hasTemporaryAdminActive() then
        return "USUÁRIO ADMIN"
    else
        return "USUÁRIO FREE"
    end
end

