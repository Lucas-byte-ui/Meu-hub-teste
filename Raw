end

local function puxarJogadorParaMim(targetPlayer)
    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp or not targetPlayer then return end

    local targetChar = targetPlayer.Character
    local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if targetHrp then
        pcall(function()
            targetHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -4)
        end)
    end
end

local function mandarParaJogador(alvoPlayer, comando, extra)
    if not alvoPlayer then return false, "Jogador inválido" end

    local payload = {
        de = LP.Name,
        comando = comando
    }

    if type(extra) == "table" then
        for k, v in pairs(extra) do
            payload[k] = v
        end
    end

    local corpo = HttpService:JSONEncode(payload)
    local ok, res = pcall(function()
        return pedirHttp({
            Url = LINK_BANCO .. "/recados/" .. tostring(alvoPlayer.UserId) .. ".json",
            Method = "PUT",
            Headers = { ["Content-Type"] = "application/json" },
            Body = corpo
        })
    end)
    return (ok and res ~= nil), (not ok or not res) and "Falha na API" or nil
end

