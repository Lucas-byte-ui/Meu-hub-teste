local function playMusic(soundId)
    soundId = tostring(soundId)
    if not tonumber(soundId) then return false, "ID inválido" end

    local boombox = getBoomboxEquipada()
    if not boombox then return false, "Equipe a Boombox na mão primeiro!" end

    local sound = boombox:FindFirstChildWhichIsA("Sound", true)
    if sound then
        sound.SoundId = "rbxassetid://" .. soundId
        sound.Looped = true
        sound.Volume = 1
        sound:Play()
    end

    local RE = game:GetService("ReplicatedStorage"):FindFirstChild("RE")
    local remote = RE and RE:FindFirstChild("PlayerToolEvent")
    if remote then
        pcall(function() remote:FireServer("ToolMusicText", soundId, nil, true) end)
        return true, nil
    end
    return false, "Remote PlayerToolEvent não encontrado."
end

